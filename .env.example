# Credentials from https://my.telegram.org/apps
API_ID=
API_HASH=

# Login session. Leave STRING_SESSION empty to log in interactively on first run;
# a <SESSION_NAME>.session file is then created next to userbot.py.
SESSION_NAME=sticker_guard
STRING_SESSION=

# Where permits are stored (relative paths resolve next to userbot.py)
DB_PATH=permits.db

# Short notice sent after a sticker is removed. NOTICE=false stays silent.
NOTICE=true
NOTICE_TEXT=▸ Stickers are blocked in this chat.

# Seconds before notices and command cards are deleted. 0 keeps them.
NOTICE_TTL=6

# Skip DMs with bots
IGNORE_BOTS=true

LOG_LEVEL=INFO
